# bs-list-eligible — print eligible issue ids for the current project, one per
# line. Used by dispatch.sh; also handy as a standalone check.
set -euo pipefail
BS_PROJECT_ROOT="$(pwd)"
BS_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export BS_PROJECT_ROOT
exec "${BS_HOME}/node_modules/.bin/tsx" "${BS_HOME}/scripts/list-eligible.ts" "$@"
