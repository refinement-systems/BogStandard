# bs-import — copy data from a chainlink SQLite DB in the current directory
# into the BogStandard postgres database. One-shot data import; not to be
# confused with bs-migrate (schema migrations).
set -euo pipefail
BS_PROJECT_ROOT="$(pwd)"
BS_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export BS_PROJECT_ROOT
if [[ ! -x "${BS_HOME}/node_modules/.bin/tsx" ]]; then
    echo "error: BogStandard dependencies are not installed." >&2
    echo "Run 'npm install' inside ${BS_HOME} first." >&2
    exit 1
fi
exec "${BS_HOME}/node_modules/.bin/tsx" "${BS_HOME}/scripts/import-from-chainlink.ts" "$@"
